---
import type { EncryptedPayload } from '../lib/crypto';

interface Props {
  payload: EncryptedPayload;
}

const { payload } = Astro.props;

// import { getAssetPath } from "@/utils/withBase";
// const markedBundlePath = getAssetPath("marked");
// const markedJsPath = markedBundlePath + "/marked.min.js";

---

<div id="password-protect" class="password-protect">
  <div id="form-area">
    <h2>This post is password protected</h2>
    <p>Enter the password to view the content.</p>

<div class="password-field">
  <input
    type="password"
    id="password-input"
    placeholder="Password"
    autocomplete="current-password"
  />
  <button type="button" id="toggle-visibility" aria-label="Show password">
    👁️
  </button>
</div>

<!--
    <input
      type="password"
      id="password-input"
      placeholder="Password"
      autocomplete="current-password"
    />
-->


    <button id="unlock-btn">Unlock</button>
    <p id="error-msg" style="color: #e11d48; display: none; margin-top: 0.75rem;">
      Incorrect password
    </p>
  </div>


</div>

<div id="decrypted-content" style="display: none;"></div>

<!-- Load marked from CDN -->
<!-- <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script> -->
<script is:inline src="/marked/marked.min.js"></script>

<script is:inline define:vars={{ payload }}>
  // import { marked } from 'marked';

  // Utility: base64 → Uint8Array
  function b64ToBytes(b64) {
    const bin = atob(b64);
    const bytes = new Uint8Array(bin.length);
    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
    return bytes;
  }

  async function deriveKey(password, salt, iterations) {
    const enc = new TextEncoder();
    const keyMaterial = await crypto.subtle.importKey(
      'raw',
      enc.encode(password),
      'PBKDF2',
      false,
      ['deriveKey']
    );

    return crypto.subtle.deriveKey(
      {
        name: 'PBKDF2',
        salt: salt,
        iterations: iterations,
        hash: 'SHA-256',
      },
      keyMaterial,
      { name: 'AES-GCM', length: 256 },
      false,
      ['decrypt']
    );
  }

  async function decrypt(password) {
    const salt = b64ToBytes(payload.salt);
    const iv = b64ToBytes(payload.iv);
    const data = b64ToBytes(payload.ciphertext);

    // Last 16 bytes are the GCM auth tag
    const authTag = data.slice(-16);
    const ciphertext = data.slice(0, -16);

    const key = await deriveKey(password, salt, payload.iterations);

    try {
      const decrypted = await crypto.subtle.decrypt(
        {
          name: 'AES-GCM',
          iv: iv,
          tagLength: 128,
        },
        key,
        // Web Crypto expects ciphertext + tag together
        new Uint8Array([...ciphertext, ...authTag])
      );

      return new TextDecoder().decode(decrypted);
    } catch (err) {
      throw new Error('Decryption failed');
    }
  }


async function tryUnlock(password, formArea, contentArea, passwordProtect, errorMsg, input) {
    errorMsg.style.display = 'none';
    try {
      const markdown = await decrypt(password);
      const html = marked.parse(markdown);

      contentArea.innerHTML = html;
      passwordProtect.style.display = 'none';
      formArea.style.display = 'none';
      contentArea.style.display = 'block';

      sessionStorage.setItem('protected-post-' + location.pathname, password);
    } catch (error) {
      errorMsg.style.display = 'block';
      input.value = '';
      input.focus();
      console.error(error);
    }
  }

  function initEventListeners() {
    const formArea = document.getElementById('form-area');
    const contentArea = document.getElementById('decrypted-content');
    const input = document.getElementById('password-input');
    const errorMsg = document.getElementById('error-msg');
    const unlockBtn = document.getElementById('unlock-btn');
    const passwordProtect = document.getElementById('password-protect');
    const toggleBtn = document.getElementById('toggle-visibility');

    // Elements not on this page → do nothing
    if (!formArea || !input || !unlockBtn || !contentArea) return;

    // Already unlocked in this page view?
    if (contentArea.innerHTML.trim() !== '') return;

    // Auto-unlock
    const saved = sessionStorage.getItem('protected-post-' + location.pathname);
    if (saved) {
      tryUnlock(saved, formArea, contentArea, passwordProtect, errorMsg, input);
      return;
    }

    // Prevent attaching listeners multiple times
    if (unlockBtn.dataset.initialized === 'true') return;
    unlockBtn.dataset.initialized = 'true';

    // Toggle password visibility
    toggleBtn?.addEventListener('click', () => {
      const isPassword = input.type === 'password';
      input.type = isPassword ? 'text' : 'password';
      toggleBtn.textContent = isPassword ? '🙈' : '👁️';
    });

    // Unlock button
    unlockBtn.addEventListener('click', () => {
      tryUnlock(input.value, formArea, contentArea, passwordProtect, errorMsg, input);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        tryUnlock(input.value, formArea, contentArea, passwordProtect, errorMsg, input);
      }
    });
  }

  // Run on first load + after every navigation
  initEventListeners();
  document.addEventListener('astro:page-load', initEventListeners);

</script>

<style>
  .password-protect {
    max-width: 28rem;
    margin: 3rem auto;
    padding: 2rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    text-align: center;
  }
  #password-input {
    display: block;
    width: 100%;
    padding: 0.6rem 0.9rem;
    margin: 1rem 0 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 0.4rem;
    font-size: 1rem;
  }
  #unlock-btn {
    padding: 0.55rem 1.4rem;
    background: #2563eb;
    color: white;
    border: none;
    border-radius: 0.4rem;
    cursor: pointer;
    font-size: 1rem;
  }
  #unlock-btn:hover {
    background: #1d4ed8;
  }

  .password-field {
    position: relative;
    display: flex;
    align-items: center;
    margin: 1rem 0 0.75rem;
  }
  
  .password-field input {
    width: 100%;
    padding: 0.6rem 2.8rem 0.6rem 0.9rem;
    border: 1px solid #d1d5db;
    border-radius: 0.4rem;
    font-size: 1rem;
  }
  
  .password-field button {
    position: absolute;
    right: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.2rem;
    padding: 0.25rem;
    line-height: 1;
  }

</style>